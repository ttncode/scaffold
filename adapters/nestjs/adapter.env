ADAPTER_NAME="nestjs"
ADAPTER_ROLE="api"
ADAPTER_TIER="A"
ADAPTER_LANGUAGE="typescript"
ADAPTER_GENERATOR='pnpm dlx @nestjs/cli@12 new "$APP_DIR" --package-manager pnpm --skip-git'
# @nestjs/cli@12 ships jest, oxlint and prettier already wired to the
# contract's tasks; main.ts's un-awaited bootstrap() trips oxlint's
# @typescript-eslint/no-floating-promises: warn rule, so bring that and
# formatting in line with the adapter's own prettier config here, once.
# .prettierignore ships as an overlay file and is already in place by the
# time this runs. Pinned to the major rather than @latest: v12 replaced
# eslint with oxlint (docs/decisions/0008), and floating on @latest is what
# let that boundary crossing surface as a broken lint task instead of a
# planned change — the same reasoning the laravel adapters already pin on.
# v12's own e2e spec imports `App` from `supertest/types`, a subpath that
# resolves nowhere: verified the real `supertest` package ships no
# types.d.ts at all, and @types/supertest's own copy lives at
# @types/supertest/types.d.ts, which plain "node" module resolution never
# reaches for a subpath import (only the package root gets the @types
# fallback) — so `tsc --noEmit` fails on generation regardless of package
# manager. INestApplication's TServer generic defaults to `any`, so this
# drops the import and the generic instead of the type it names.
ADAPTER_POST_GENERATE='sed -i "s/^bootstrap();$/void bootstrap();/" src/main.ts && sed -i "/^import { App } from .supertest\/types.;$/d; s/INestApplication<App>/INestApplication/" test/app.e2e-spec.ts && pnpm exec prettier --write .'
