ADAPTER_NAME="nestjs"
ADAPTER_ROLE="api"
ADAPTER_TIER="A"
ADAPTER_LANGUAGE="typescript"
# pinned to v11, not @latest: @nestjs/schematics v12's application template
# drops eslint/jest for oxlint/vitest, and its vitest.config.ts ships no
# decorator-metadata transform (no unplugin-swc/@swc/core) — vitest's
# default esbuild transform does not implement emitDecoratorMetadata, so
# Nest's DI never injects AppService into AppController and the generated
# unit test fails on every fresh project. Separately, v12's own vitest
# (^4.1.2) needs vite ^6/^7/^8, but nothing in the template pins vite, and
# pnpm resolves an incompatible 5.4.21 that crashes before tests even run.
# Reproduced both from a plain `scaffold new x --api nestjs`, independent of
# this toolbox's own choices. v11's ts-jest stack has no such gap. Before
# moving off this pin: generate with `@nestjs/cli@12` (or whatever the
# current major is) and confirm `mise run //apps/api:ci-unit` passes clean
# on a fresh checkout — not just that oxlint.json/vitest.config.ts exist.
ADAPTER_GENERATOR='pnpm dlx @nestjs/cli@11 new "$APP_DIR" --package-manager pnpm --skip-git'
# @nestjs/cli ships jest, eslint and prettier already wired to the contract's
# tasks; main.ts's un-awaited bootstrap() trips --max-warnings 0 and
# eslint.config.mjs mixes quote styles, so bring both in line with the
# adapter's own prettier config here, once. .prettierignore ships as an
# overlay file and is already in place by the time this runs.
ADAPTER_POST_GENERATE='sed -i "s/^bootstrap();$/void bootstrap();/" src/main.ts && pnpm exec prettier --write .'
