ADAPTER_NAME="nextjs"
ADAPTER_ROLE="web"
ADAPTER_TIER="A"
ADAPTER_LANGUAGE="typescript"
# node and pnpm come from the project root, so this adapter declares no tools
# pinned to the major, not @latest — see docs/decisions/0008 and the nestjs
# adapter's env: an unpinned TypeScript generator is exactly what let that
# adapter's lint task break silently across a major it never noticed crossing
ADAPTER_GENERATOR='pnpm create next-app@16 "$APP_DIR" --ts --app --eslint --tailwind --src-dir --import-alias "@/*" --use-pnpm --yes'
# create-next-app ships neither prettier nor vitest, and its own output is not
# prettier-formatted; bring it up to the contract once, here, so format/test
# have something to check against from the start. .prettierignore ships as an
# overlay file and is already in place by the time this runs.
ADAPTER_POST_GENERATE='pnpm add -D prettier vitest && pnpm exec prettier --write .'
