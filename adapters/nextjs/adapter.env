ADAPTER_NAME="nextjs"
ADAPTER_ROLE="web"
ADAPTER_TIER="A"
# node and pnpm come from the project root, so this adapter declares no tools
# create-next-app ships neither prettier nor vitest, and its own output is not
# prettier-formatted; add both and format once so the contract's format/test
# tasks have something to check against from the start. lockfiles are never
# reformatted.
ADAPTER_GENERATOR='pnpm create next-app@latest "$APP_DIR" --ts --app --eslint --tailwind --src-dir --import-alias "@/*" --use-pnpm --yes && cd "$APP_DIR" && pnpm add -D prettier vitest && printf "pnpm-lock.yaml\n" > .prettierignore && pnpm exec prettier --write .'
