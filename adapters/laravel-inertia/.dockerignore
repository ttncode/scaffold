# vendor is copied from a pinned build stage
vendor
node_modules

.env
.env.*
!.env.example
.git
storage/logs
storage/framework/cache

# both the directory and its manifests must survive: composer writes them
# locally, naming dev providers a --no-dev image lacks, but artisan also
# refuses to boot without the directory itself present — for this adapter the
# failure surfaces in vite's wayfinder plugin, several stages from the cause
bootstrap/cache/*.php

# a build context is not a git tree: without this, a host `npm run build`
# ships over what the assets stage just built
public/build
