ADAPTER_NAME="laravel-inertia"
ADAPTER_ROLE="app"
# measured at ~5 minutes per test (composer create-project, npm install,
# vite build) — task 13 found the five tests in tests/new-laravel-inertia.bats
# alone cost ~25 minutes, far past a pull-request lane. see docs/decisions/0012.
ADAPTER_TIER="B"
ADAPTER_LANGUAGE="php"
# breeze's artisan-installer route (breeze:install vue) is not the current
# path for a laravel 13 inertia+vue app: laravel's own starter kits
# (laravel/vue-starter-kit) replaced it, and that package's own tagged
# releases (up to v1.0.2) still pin laravel/framework ^12.0 — none targets
# 13.x yet. dev-main already requires php ^8.3 and laravel/framework ^13.17,
# matching laravel-api's ^13.0 pin and this machine's system php (8.3.21 —
# see docs/decisions/0016), so it is pinned to a specific commit rather than
# left floating on the branch: create-project then resolves the same tree
# on every run instead of whatever dev-main happens to point to that day.
# bump this to a tagged release once laravel/vue-starter-kit cuts one that
# targets laravel 13 — check `composer show -a laravel/vue-starter-kit`; a
# tag replacing this dev-main pin is strictly simpler to keep current.
# the starter kit's own composer.json runs `@php artisan install:features --ansi`
# on install with no -n/--no-interaction of its own, and composer's --no-interaction
# above does not propagate into that script line (verified: composer does not export
# it or rewrite the command). that command's interactivity comes from Symfony
# Console's own --no-interaction/-n check, which SHELL_VERBOSITY=-1 also satisfies
# (Console\Application::configureIO) — set here so the feature-selection prompt
# chisel would otherwise run resolves to defaults instead of waiting on a real
# terminal's input.
ADAPTER_GENERATOR='SHELL_VERBOSITY=-1 composer create-project "laravel/vue-starter-kit:dev-main#11a7368240d7d9146415aa6bfc858a90b6ce8490" "$APP_DIR" --no-interaction --prefer-dist'
