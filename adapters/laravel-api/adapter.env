ADAPTER_NAME="laravel-api"
ADAPTER_ROLE="api"
ADAPTER_TIER="A"
ADAPTER_LANGUAGE="php"
# laravel/laravel with no version pin resolves to whatever the local php
# allows, silently: 13.x needs php ^8.3, 12.x needs php ^8.2. this machine's
# system php (8.3.21, not mise-managed — see docs/decisions/0016) supports
# 13.x, so that major is pinned explicitly and mise.toml's install guard is
# kept in lockstep with the same ^8.3 floor.
ADAPTER_GENERATOR='composer create-project laravel/laravel:^13.0 "$APP_DIR" --no-interaction --prefer-dist'
# the skeleton ships phpunit and pint but not static analysis; bring the
# result up to the check contract task here, once. phpstan.neon ships as an
# overlay file and is already in place by the time this runs.
ADAPTER_POST_GENERATE='composer require --dev larastan/larastan phpstan/phpstan --no-interaction && printf "\n# throwaway tree for the build task; see mise.toml\n/vendor-dist\n" >> .gitignore'
