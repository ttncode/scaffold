APP_ENV=local
APP_KEY=
# off by default: `cp .env.example .env` is how most deploys start, and
# Laravel's debug page renders the whole environment — APP_KEY and
# DB_PASSWORD included — to anyone who triggers a 500. Turn it on locally.
APP_DEBUG=false
APP_URL=http://localhost:8000
# the database variables are written by the selected service's driver
