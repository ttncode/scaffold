#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# Script      : scaffold
# Description : Create and extend projects that follow the task contract.
# Author      : ttncode
#
# Usage:
#   scaffold                    interactive wizard (needs a terminal)
#   scaffold new <name> [--web|--api|--app <adapter>]... [--db|--cache <service>]
#   scaffold add <dir> --adapter <adapter>
#   scaffold update [dir] [--dry-run]
#   scaffold publish [dir] [--public] [--no-protect] [--dry-run]
#   scaffold list [--adapters] [--services]
#   scaffold lint
#
# Example:
#   scaffold new demo --web nextjs --api nestjs --db postgres
# ═══════════════════════════════════════════════════════════════════════════

set -euo pipefail

SCAFFOLD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCAFFOLD_ROOT

# shellcheck source=lib/log.sh
source "${SCAFFOLD_ROOT}/lib/log.sh"
# shellcheck source=lib/contract.sh
source "${SCAFFOLD_ROOT}/lib/contract.sh"
# shellcheck source=lib/lint.sh
source "${SCAFFOLD_ROOT}/lib/lint.sh"
# shellcheck source=lib/adapter.sh
source "${SCAFFOLD_ROOT}/lib/adapter.sh"
# shellcheck source=lib/service.sh
source "${SCAFFOLD_ROOT}/lib/service.sh"
# shellcheck source=lib/wizard.sh
source "${SCAFFOLD_ROOT}/lib/wizard.sh"
# shellcheck source=lib/tui.sh
source "${SCAFFOLD_ROOT}/lib/tui.sh"
# shellcheck source=lib/project.sh
source "${SCAFFOLD_ROOT}/lib/project.sh"
# shellcheck source=lib/pnpm.sh
source "${SCAFFOLD_ROOT}/lib/pnpm.sh"
# shellcheck source=lib/manifest.sh
source "${SCAFFOLD_ROOT}/lib/manifest.sh"
# shellcheck source=lib/update.sh
source "${SCAFFOLD_ROOT}/lib/update.sh"
# shellcheck source=lib/publish.sh
source "${SCAFFOLD_ROOT}/lib/publish.sh"

REQUIRED_TOOLS=(git mise jq yq)

# The services this run selected, read by apply_adapter. One value for the whole
# run, and apply_adapter already takes three parameters.
SCAFFOLD_SERVICES=()

usage() {
  cat <<'EOF'
usage:
  scaffold                    interactive wizard (needs a terminal)
  scaffold new <name> [--web <adapter>] [--api <adapter>] [--app <adapter>]
                      [--db <service>] [--cache <service>]
  scaffold add <dir> --adapter <adapter>
  scaffold update [dir] [--dry-run]
  scaffold publish [dir] [--public] [--no-protect] [--dry-run]
  scaffold list [--adapters] [--services]
  scaffold lint
  scaffold --version
EOF
}

# ─── the toolchain ─────────────────────────────────────────────────────────

# jq and yq are pinned in this toolbox's own mise.toml, so scaffold loads that
# environment itself rather than asking every caller to wrap the command in one.
#
# `mise env -C`, not `mise exec -C`: exec changes directory too, and a relative
# target then resolves against the toolbox — `scaffold new demo` lands inside
# the toolbox instead of where it was run. Silent: require_tools reports a real
# absence, by name.
load_toolchain_env() {
  command -v jq >/dev/null 2>&1 && command -v yq >/dev/null 2>&1 && return 0
  command -v mise >/dev/null 2>&1 || return 0

  local environment
  environment="$(mise env -C "$SCAFFOLD_ROOT" -s bash 2>/dev/null)" || return 0
  eval "$environment"
}

# load_toolchain_env runs first and usually supplies jq and yq, so what reaches
# here is a genuine absence. Fail by name, before touching disk.
require_tools() {
  local tool missing=()

  for tool in "${REQUIRED_TOOLS[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done

  [ "${#missing[@]}" -eq 0 ] && return 0
  die "missing required tool(s): ${missing[*]} — run 'mise install' in ${SCAFFOLD_ROOT}"
}

# `mise exec` walks upward for config and permanently trusts what it finds, then
# runs any `_.source` or `{{ exec(...) }}` in that config's [env]. Generate a
# project inside a tree you did not write and someone else's mise.toml executes,
# with none of the asking mise exists to do. Only `mise exec` walks.
#
# Set once rather than threaded through the one function somebody remembered: a
# run spawns mise from pnpm_install, record_release_age_exceptions,
# sync_workspace_lockfile and every generator, and must cover all of them.
confine_mise_to() {
  MISE_CEILING_PATHS="$(dirname "$1")"
  export MISE_CEILING_PATHS
}

# resolve_project [dir] <command> — the project a command acts on: the given
# directory, or the git root of wherever it was run.
resolve_project() {
  local rel="$1" command="$2" project

  if [ -n "$rel" ]; then
    project="$(cd "$rel" 2>/dev/null && pwd)" || die "no such directory: ${rel}"
  else
    project="$(git rev-parse --show-toplevel 2>/dev/null)" \
      || die "not inside a git repository: run 'scaffold ${command}' from inside a project created by 'scaffold new', or give its path"
  fi

  is_scaffold_project "$project" || die "not a scaffold project (${project})"
  printf '%s' "$project"
}

# ─── commands ──────────────────────────────────────────────────────────────

# Filled by collect_adapter_rows / collect_service_rows, which both return 1 on
# anything malformed so `scaffold list` still prints every good row.
LIST_ROWS=()

collect_adapter_rows() {
  local adapter name status=0

  for adapter in "${SCAFFOLD_ROOT}"/adapters/*/; do
    [ -d "$adapter" ] || continue
    name="$(basename "$adapter")"

    if load_adapter "$name" 2>/dev/null; then
      # shellcheck disable=SC2153 # ADAPTER_NAME, ADAPTER_ROLE, ADAPTER_TIER are sourced from adapter.env
      LIST_ROWS+=("$ADAPTER_NAME"$'\t'"$ADAPTER_ROLE"$'\t'"$ADAPTER_TIER")
    else
      LIST_ROWS+=("[error]"$'\t'"$name"$'\t'"(malformed adapter)")
      status=1
    fi

    unset -v ADAPTER_DIR ADAPTER_NAME ADAPTER_GENERATOR "${ADAPTER_OPTIONAL_VARS[@]}"
  done

  return "$status"
}

collect_service_rows() {
  local service name status=0

  for service in "${SCAFFOLD_ROOT}"/services/*/; do
    [ -d "$service" ] || continue
    name="$(basename "$service")"
    [ "$name" = "$SHARED_DRIVERS_DIR" ] && continue

    if load_service "$name" >/dev/null 2>&1; then
      LIST_ROWS+=("$SERVICE_NAME"$'\t'"$SERVICE_KIND"$'\t'"-")
    else
      LIST_ROWS+=("[error]"$'\t'"$name"$'\t'"(malformed service)")
      status=1
    fi

    unset -v SERVICE_DIR SERVICE_NAME SERVICE_KIND SERVICE_IMAGE
  done

  return "$status"
}

cmd_list() {
  local status=0
  local want_adapters=0 want_services=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --adapters) want_adapters=1; shift ;;
      --services) want_services=1; shift ;;
      *) die "unknown option: ${1}" ;;
    esac
  done

  # neither flag given: list both, the human default `scaffold list` keeps
  if [ "$want_adapters" -eq 0 ] && [ "$want_services" -eq 0 ]; then
    want_adapters=1
    want_services=1
  fi

  LIST_ROWS=()
  [ "$want_adapters" -eq 1 ] && { collect_adapter_rows || status=1; }
  [ "$want_services" -eq 1 ] && { collect_service_rows || status=1; }

  printf '%s\n' ${LIST_ROWS[@]+"${LIST_ROWS[@]}"} | sort
  return "$status"
}

cmd_lint() {
  local status=0
  lint_adapters "${SCAFFOLD_ROOT}/adapters" || status=1
  lint_services "${SCAFFOLD_ROOT}/services" "${SCAFFOLD_ROOT}/adapters" || status=1
  return "$status"
}

# EXIT, not ERR: die() exits directly and never trips an ERR trap.
#
# Known gap: this removes the directory but not a generator's orphaned child
# process, which can keep writing into $target after the rm -rf.
cmd_new_cleanup() {
  local target="$1" status="$2"

  [ "$status" -eq 0 ] && return 0
  [ -n "$target" ] || return 0

  rm -rf "$target"
  warn "removed incomplete project: ${target}"
}

# Set by parse_new_flags and read by the steps below, the same way tui_select
# returns through TUI_CHOICE.
NEW_APPS=()
NEW_DATABASE=""
NEW_CACHE=""

parse_new_flags() {
  NEW_APPS=()
  NEW_DATABASE=""
  NEW_CACHE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --web|--api|--app)
        [ $# -ge 2 ] || die "${1} requires an adapter name"
        # each role maps to one apps/<role> directory, so a repeated flag runs
        # a second generator over the first app's files, silently
        case " ${NEW_APPS[*]-} " in
          *" ${1#--}:"*) die "${1} given more than once" ;;
        esac
        NEW_APPS+=("${1#--}:${2}")
        shift 2
        ;;
      --db)
        [ $# -ge 2 ] || die "--db requires a service name"
        [ -z "$NEW_DATABASE" ] || die "--db given more than once"
        NEW_DATABASE="$2"
        shift 2
        ;;
      --cache)
        [ $# -ge 2 ] || die "--cache requires a service name"
        [ -z "$NEW_CACHE" ] || die "--cache given more than once"
        NEW_CACHE="$2"
        shift 2
        ;;
      *) die "unknown option: ${1}" ;;
    esac
  done
}

project_has_backend() {
  local entry
  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    case "$entry" in api:*|app:*) return 0 ;; esac
  done
  return 1
}

# assert_service_connectable <flag> <kind> <service>
# The web tier takes no driver, so a project with no api or app adapter would
# get a running service, a set of variables, and no way to reach either.
assert_service_connectable() {
  local flag="$1" kind="$2" service="$3"

  [ "$service" != none ] || return 0
  project_has_backend \
    || die "${flag} ${service} but there is no application to connect it — add --api or --app"
  load_service "$service"
  [ "$SERVICE_KIND" = "$kind" ] \
    || die "${service} is a ${SERVICE_KIND}, not a ${kind}"
}

resolve_service_selection() {
  if [ -z "$NEW_DATABASE" ]; then
    project_has_backend && NEW_DATABASE="$DEFAULT_DATABASE_SERVICE" || NEW_DATABASE=none
  fi
  [ -n "$NEW_CACHE" ] || NEW_CACHE=none

  assert_service_connectable --db database "$NEW_DATABASE"
  assert_service_connectable --cache cache "$NEW_CACHE"

  SCAFFOLD_SERVICES=()
  local service
  for service in "$NEW_DATABASE" "$NEW_CACHE"; do
    [ "$service" != none ] && SCAFFOLD_SERVICES+=("$service")
  done
  return 0
}

install_adapters() {
  local target="$1"
  local entry role adapter rel

  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    role="${entry%%:*}"
    adapter="${entry#*:}"
    load_adapter "$adapter"
    [ "$ADAPTER_ROLE" = "$role" ] \
      || die "adapter ${adapter} has role ${ADAPTER_ROLE}, not ${role}"
    rel="$(role_path "$ADAPTER_ROLE")"
    # Before the adapter: apply_adapter runs the service drivers, and a
    # driver's compose environment merges into this app's own service.
    add_app_service "$target" "$rel" "$ADAPTER_ROLE"
    apply_adapter "$adapter" "$target" "$rel"
    record_scaffold_app "$target" "$rel" "$adapter"
  done
}

# A shared packages/types needs every application to be TypeScript. The root
# pnpm-workspace.yaml survives either way: it carries ADR-0017's allowBuilds for
# any node install, so one PHP app must not delete the policy protecting the
# TypeScript app beside it.
#
# register_image_target runs last because a build context depends on the
# decision above: a workspace member builds from the root, an application that
# owns its manifests from its own directory (ADR-0022).
settle_workspace_shape() {
  local target="$1"
  local entry all_typescript=1
  local -a apps=()

  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    adapter_is_typescript "${entry#*:}" || all_typescript=0
    apps+=("$(role_path "${entry%%:*}"):${entry#*:}")
  done

  if [ "${#apps[@]}" -gt 0 ] && [ "$all_typescript" -eq 1 ]; then
    join_typescript_workspace "$target" "${apps[@]}"
  else
    keep_apps_standalone "$target" ${apps[@]+"${apps[@]}"}
  fi

  local pair
  for pair in ${apps[@]+"${apps[@]}"}; do
    register_image_target "$target" "${pair%%:*}"
  done
}

print_next_steps() {
  log ""
  log "created ${1}"
  log ""
  log "next:"
  log "  cd ${1}"
  log "  mise install && mise exec -- lefthook install"
  log "  scaffold publish              # create its GitHub repository"
  log "  mise run checklist            # what CI will run"
}

cmd_new() {
  [ $# -gt 0 ] || die "new requires a project name"

  local target="$1"; shift
  # Absolute once here: apply_service_drivers exports it as
  # SCAFFOLD_PROJECT_ROOT into a driver's child, whose cwd is the app directory.
  case "$target" in
    /*) ;;
    *) target="$(pwd)/${target}" ;;
  esac

  confine_mise_to "$target"
  parse_new_flags "$@"
  resolve_service_selection

  # init_project arms the EXIT trap right after it creates $target, so a failure
  # inside it is covered too.
  init_project "$target" "$(basename "$target")"
  init_scaffold_manifest "$target"

  record_services "$target" "$NEW_DATABASE" "$NEW_CACHE"
  assemble_compose "$target" ${SCAFFOLD_SERVICES[@]+"${SCAFFOLD_SERVICES[@]}"}
  assemble_example_env "$target" ${SCAFFOLD_SERVICES[@]+"${SCAFFOLD_SERVICES[@]}"}

  install_adapters "$target"
  settle_workspace_shape "$target"

  step "locking the toolchain and committing"
  finalize_project "$target"
  trap - EXIT

  print_next_steps "$target"
}

# cmd_add_cleanup <target> <status> <workspace-file>
# cmd_new_cleanup plus the workspace relaxations, which must not survive a
# failure any more than they survive success.
#
# Reach is partial: a failure after apply_adapter leaves the config_roots entry,
# the merged lefthook fragment, the rewritten lockfile and the roots: line
# behind, all naming an app that got removed. Editing files the caller already
# owned has no general undo.
cmd_add_cleanup() {
  local target="$1" status="$2" workspace_file="$3"

  restore_pnpm_workspace "$workspace_file"

  [ "$status" -eq 0 ] && return 0
  [ -n "$target" ] || return 0

  rm -rf "$target"
  warn "removed incomplete app: ${target}"
}

# add_project_root — the project `scaffold add` acts on, resolved against the
# git root rather than the caller's cwd so it works the same three levels down
# inside an existing app.
add_project_root() {
  local project
  project="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository: run 'scaffold add' from inside a project created by 'scaffold new'"
  is_scaffold_project "$project" \
    || die "not a scaffold project (${project}): run 'scaffold add' from inside a project created by 'scaffold new'"
  printf '%s' "$project"
}

# Read back rather than asked for: an application added in month six wires to
# the database the project has had since month one.
load_recorded_services() {
  local project="$1" kind recorded

  SCAFFOLD_SERVICES=()
  for kind in database cache; do
    recorded="$(project_service "$project" "$kind")"
    [ -n "$recorded" ] && SCAFFOLD_SERVICES+=("$recorded")
  done
  return 0
}

# joins_shared_workspace <project> <adapter> — true when this adapter will
# resolve through the project's shared pnpm workspace.
#
# Keyed on a real shared workspace, not merely on the file existing: a
# mixed-language project keeps a settings-only pnpm-workspace.yaml with no
# `packages:`, and the reconcile branch's sync_workspace_lockfile would delete
# every per-app lockfile and rebuild a root one covering no app.
joins_shared_workspace() {
  local workspace_file="${1}/${WORKSPACE_FILE}"

  [ -f "$workspace_file" ] \
    && [ "$(yq -r '.packages // "absent"' "$workspace_file")" != "absent" ] \
    && adapter_is_typescript "$2"
}

reconcile_shared_workspace() {
  # The new app's own generator already installed straight into the shared root
  # lockfile; this catches anything it didn't, and records any new
  # minimum-release-age violations the same way `scaffold new` does.
  sync_workspace_lockfile "$1"
  record_release_age_exceptions "$1"
}

# reconcile_standalone_app <project> <rel> <adapter>
# `scaffold new` drops the root workspace file when nothing TypeScript is
# requested, so adding the project's first TypeScript app brings ADR-0017's
# build policy into scope with no file to hold it — pnpm then refuses the
# install outright (ERR_PNPM_IGNORED_BUILDS). Restored without the packages
# list: there is still no shared workspace here.
reconcile_standalone_app() {
  local project="$1" rel="$2" adapter="$3"
  local workspace_file="${project}/${WORKSPACE_FILE}"

  if adapter_is_typescript "$adapter" && [ ! -f "$workspace_file" ]; then
    yq '{"allowBuilds": .allowBuilds}' \
      "${SCAFFOLD_ROOT}/common/${WORKSPACE_FILE}" > "$workspace_file"
  fi

  # Install from the app, record in the root: the app is where pnpm resolves its
  # dependencies, and the root workspace file is what pnpm reads when it walks up
  # from there. Running both halves at the root found no violation, because the
  # root package.json names none of the app's dependencies.
  record_release_age_exceptions "${project}/${rel}" "$project"
}

# Only the new app is staged. Edits to files the caller already owned —
# mise.toml, ci.yml, lefthook.yml, the lockfile — stay unstaged so `git diff`
# shows them before they enter anyone's history. A failed `git add` is retriable
# by hand, so it is reported, not fatal.
stage_new_app() {
  local project="$1" rel="$2" adapter="$3"

  if git -C "$project" add -A -- "$rel"; then
    log "added ${rel} using ${adapter}; review and commit"
  else
    warn "added ${rel} using ${adapter}, but staging failed: the app was generated and the configuration was updated, run 'git add' yourself to stage it"
  fi
}

# cmd_add <dir> --adapter <adapter> — install one more adapter into a project
# `scaffold new` already created, wherever that project's git root is relative
# to the caller's cwd.
cmd_add() {
  [ $# -ge 3 ] || die "usage: scaffold add <dir> --adapter <adapter>"

  local rel="$1"; shift
  local adapter=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --adapter)
        [ $# -ge 2 ] || die "--adapter requires an adapter name"
        adapter="$2"
        shift 2
        ;;
      *) die "unknown option: ${1}" ;;
    esac
  done

  [ -n "$adapter" ] || die "--adapter is required"

  local project; project="$(add_project_root)"
  confine_mise_to "$project"
  load_recorded_services "$project"

  local dest="${project}/${rel}"
  [ -e "$dest" ] && die "path already exists: ${rel}"

  # Before apply_adapter's own call: add_app_service below needs the role to
  # decide whether this application waits on the database.
  load_adapter "$adapter"

  local reconcile=0
  joins_shared_workspace "$project" "$adapter" && reconcile=1

  # Armed only once the guard above proves $dest is absent, or this is rm -rf on
  # a path the caller already had. Values baked in with printf %q, because the
  # locals are gone by the time the trap fires.
  local workspace_file="${project}/${WORKSPACE_FILE}"
  # shellcheck disable=SC2064 # $dest/$workspace_file expanding now is intentional; $? is escaped and still deferred
  trap "cmd_add_cleanup $(printf '%q' "$dest") \"\$?\" $(printf '%q' "$workspace_file")" EXIT

  relax_pnpm_workspace "$workspace_file"

  # Before the adapter, for the same reason as cmd_new's: a driver's compose
  # environment merges into this application's own service.
  add_app_service "$project" "$rel" "$ADAPTER_ROLE"
  apply_adapter "$adapter" "$project" "$rel"

  # Reads whether rel already falls inside the workspace file's packages: globs.
  # It does not recompute whether the project is all-typescript (ADR-0018).
  finalize_app_dockerfile "$project" "$rel"

  # On the success path too: it disarms the cleanup trap below, so leaving this
  # to the trap keeps the relaxations in the caller's file forever.
  restore_pnpm_workspace "$workspace_file"

  if [ "$reconcile" -eq 1 ]; then
    reconcile_shared_workspace "$project"
  else
    reconcile_standalone_app "$project" "$rel" "$adapter"
  fi

  sync_ci_roots "$project"
  # After finalize_app_dockerfile above, which is what settles whether this
  # application builds from the workspace root or from its own directory.
  register_image_target "$project" "$rel"
  record_scaffold_app "$project" "$rel" "$adapter"
  trap - EXIT

  stage_new_app "$project" "$rel" "$adapter"
}

# update_source_commit <project> — the toolbox commit this project was
# generated from, refused when there is nothing to diff against.
update_source_commit() {
  local project="$1" from

  from="$(manifest_version "$project")" || die "$(printf '%s\n' \
    "no ${SCAFFOLD_MANIFEST} in ${project}, so there is nothing to update from." \
    "" \
    "A project generated before this file existed can adopt it: write" \
    "${SCAFFOLD_MANIFEST} with the toolbox commit it came from and the adapter" \
    "behind each application, then run this again." \
    "" \
    "  version = \"<commit>\"" \
    "" \
    "  [apps]" \
    "  \"apps/api\" = \"nestjs\"")"

  case "$from" in
    *-dirty)
      die "${SCAFFOLD_MANIFEST} records ${from}: this project was generated from uncommitted edits, so there is no commit to diff against" ;;
  esac
  git -C "$SCAFFOLD_ROOT" rev-parse --verify --quiet "${from}^{commit}" >/dev/null \
    || die "this toolbox has no commit ${from} — the checkout that generated ${project} is not this one, or its history was rewritten"

  printf '%s' "$from"
}

# Recorded even when hunks were rejected: the diff has been delivered, and what
# is left is a human's to place. Re-running from the old version would offer
# every hunk that already landed a second time.
record_update_version() {
  local project="$1"

  sed -i.bak "s|^version = .*|version = \"$(scaffold_version)\"|" \
    "${project}/${SCAFFOLD_MANIFEST}"
  rm -f "${project}/${SCAFFOLD_MANIFEST}.bak"
}

report_rejected_hunks() {
  local project="$1"
  local -a rejected=()

  mapfile -t rejected < <(cd "$project" && git ls-files --others --exclude-standard -- '*.rej')
  [ "${#rejected[@]}" -gt 0 ] || return 0

  warn "$(printf '%s\n' "${#rejected[@]} file(s) could not be applied in full:" "${rejected[@]/#/  }" \
    "each .rej holds the hunks that did not fit — place them by hand, then delete it")"
}

cmd_update() {
  local rel="" dry_run=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -*) die "unknown option: ${1}" ;;
      *)
        [ -z "$rel" ] || die "update takes at most one directory"
        rel="$1"; shift ;;
    esac
  done

  local project; project="$(resolve_project "$rel" update)"
  local from; from="$(update_source_commit "$project")"
  SCAFFOLD_UPDATE_FROM="$from"

  local patch; patch="$(mktemp)"
  update_patch "$project" > "$patch"

  if [ ! -s "$patch" ]; then
    rm -f "$patch"
    log "already up to date with $(scaffold_version)"
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    cat "$patch"
    rm -f "$patch"
    return 0
  fi

  # A dirty tree would make the result unreadable: `git diff` after this is the
  # only review anyone gets, and it has to show this run's changes alone.
  [ -z "$(git -C "$project" status --porcelain)" ] \
    || { rm -f "$patch"; die "${project} has uncommitted changes — commit or stash them first, so 'git diff' afterwards shows only what this brought in"; }

  local status=0
  git -C "$project" apply --reject --whitespace=nowarn "$patch" || status=$?
  rm -f "$patch"

  resync_derived_files "$project"
  record_update_version "$project"

  log "updated ${project} from ${from} to $(scaffold_version)"
  report_rejected_hunks "$project"
  log "review with 'git -C ${project} diff' before committing"
  return "$status"
}

# apply_repo_settings <slug> <protect:0|1>
# A setting this account's plan does not allow is a warning, not a failure:
# refusing here would make the whole command unusable for exactly the accounts
# that most need the steps before it.
apply_repo_settings() {
  local slug="$1" protect="$2" status=0

  allow_actions_to_open_pull_requests "$slug"
  log "Actions may open pull requests (Release Please needs this)"

  enable_secret_scanning "$slug" || status=$?
  case "$status" in
    0) log "secret scanning and push protection are on" ;;
    "$PUBLISH_UNSUPPORTED") warn "no secret scanning: it needs Advanced Security on a private repository. The CI scan still runs on every push" ;;
    *) die "could not enable secret scanning on ${slug}" ;;
  esac

  [ "$protect" -eq 1 ] && protect_main_branch "$slug"

  if set_release_secrets "$slug"; then
    log "set RELEASE_APP_ID and RELEASE_APP_PRIVATE_KEY"
  else
    warn "no RELEASE_APP_ID/RELEASE_APP_PRIVATE_KEY in the environment — Release Please will open its pull request as GITHUB_TOKEN, whose checks sit at 'Action required' and then expire red. Merging it still releases."
  fi
  return 0
}

protect_main_branch() {
  local slug="$1" status=0

  if main_is_protected "$slug"; then
    log "main already has a ruleset — left alone"
    return 0
  fi

  protect_main "$slug" || status=$?
  case "$status" in
    0) log "protected main: pull request required, no force-push, no deletion" ;;
    "$PUBLISH_UNSUPPORTED") warn "main is unprotected: this account's plan does not allow rulesets on a private repository. Make it public, or upgrade, then run this again — ADR-0004 counts branch protection as one of four guardrails, and it is the only one that is not a file" ;;
    *) die "could not protect main on ${slug}" ;;
  esac
}

# cmd_publish [dir] [--public] [--no-protect] [--dry-run]
#
# Idempotent: against a repository that exists it only fills in the settings —
# the half people forget, and the half nothing in the project's files records.
cmd_publish() {
  local rel="" visibility=private protect=1 dry_run=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --public) visibility=public; shift ;;
      --private) visibility=private; shift ;;
      --no-protect) protect=0; shift ;;
      --dry-run) dry_run=1; shift ;;
      -*) die "unknown option: ${1}" ;;
      *)
        [ -z "$rel" ] || die "publish takes at most one directory"
        rel="$1"; shift ;;
    esac
  done

  command -v gh >/dev/null 2>&1 \
    || die "publish needs the GitHub CLI: install gh and run 'gh auth login'"
  gh auth status >/dev/null 2>&1 \
    || die "not signed in to GitHub: run 'gh auth login'"

  local project; project="$(resolve_project "$rel" publish)"

  local slug; slug="$(repo_slug "$project")"
  local exists=0; gh_repo_exists "$slug" && exists=1

  [ "$exists" -eq 1 ] || assert_repo_creatable "$project" "$slug"

  if [ "$dry_run" -eq 1 ]; then
    print_publish_plan "$slug" "$visibility" "$exists" "$protect"
    return 0
  fi

  if [ "$exists" -eq 1 ]; then
    log "${slug} already exists — applying settings only"
  else
    create_repo "$project" "$slug" "$visibility"
    log "created ${slug} (${visibility}) and pushed main"
  fi

  apply_repo_settings "$slug" "$protect"

  log "https://github.com/${slug}"
}

# `gh repo create --push` pushes the checked-out branch and makes it the
# default, so publishing from a feature branch leaves the project with no main.
assert_repo_creatable() {
  local project="$1" slug="$2"

  local branch; branch="$(git -C "$project" rev-parse --abbrev-ref HEAD)"
  [ "$branch" = main ] \
    || die "publish creates ${slug} from the branch you are on, and that branch becomes its default — check out main first (you are on ${branch})"
  [ -z "$(git -C "$project" status --porcelain)" ] \
    || die "${project} has uncommitted changes — commit them first, so what reaches ${slug} is what you reviewed"

  # An origin pointing somewhere else, while ${slug} does not exist, means this
  # project is already pushing to a repository that is not the one it names.
  # Creating a second one beside it is the confusion this command exists to
  # prevent, and `gh repo create --remote origin` fails on it anyway — with
  # "Unable to add remote", which says nothing about why.
  local origin=""
  if origin="$(git -C "$project" remote get-url origin 2>/dev/null)"; then
    die "$(printf '%s\n' \
      "${project} already pushes to ${origin}, but it names ${slug}." \
      "Publishing would create a second repository beside the one it is already using." \
      "Point the project at the repository it has ([vars] image in mise.toml, and" \
      "the same pair in compose.yaml, install.sh and the build workflows), or drop" \
      "the remote with 'git -C ${project} remote remove origin'.")"
  fi
}

print_publish_plan() {
  local slug="$1" visibility="$2" exists="$3" protect="$4"

  if [ "$exists" -eq 1 ]; then
    log "would leave ${slug} alone: it already exists"
  else
    log "would create ${slug} (${visibility}) and push main"
  fi

  log "would allow Actions to open pull requests on ${slug}"
  log "would enable secret scanning and push protection"

  if [ "$protect" -eq 1 ]; then
    if main_is_protected "$slug"; then
      log "would leave main's protection alone: a ruleset named main already exists"
    else
      log "would protect main on ${slug}: pull request required, no force-push, no deletion"
    fi
  fi

  if [ -n "${RELEASE_APP_ID:-}" ] && [ -n "${RELEASE_APP_PRIVATE_KEY:-}" ]; then
    log "would set RELEASE_APP_ID and RELEASE_APP_PRIVATE_KEY"
  else
    log "would skip the release app secrets: they are not in the environment"
  fi
}

# ─── the wizard ────────────────────────────────────────────────────────────

# _wizard_select_or_cancel <prompt> <option>... — tui_select, with Esc mapped
# onto the same exit tui_begin gives Ctrl-C. No back navigation by design (§9).
_wizard_select_or_cancel() {
  tui_select "$@" || exit 130
}

# _wizard_confirm <prompt> — `y`, not Enter: everything below this line changes
# something that already exists.
_wizard_confirm() {
  printf '%b' "${BOLD}${1} [y/N] ${RESET}" >&2
  local reply=""
  IFS= read -r reply || true
  case "$reply" in y|Y) return 0 ;; *) return 1 ;; esac
}

_wizard_update() {
  tui_end
  log ""
  wizard_echo_command "scaffold update"
  log ""
  _wizard_confirm "Bring ${1} up to this toolbox?" || return 0
  [ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" = 1 ] && return 0
  cmd_update "$1"
}

_wizard_publish() {
  local -a options
  mapfile -t options < <(wizard_visibilities)
  _wizard_select_or_cancel "$WIZARD_VISIBILITY_PROMPT" "${options[@]}"
  local visibility="$TUI_CHOICE"

  tui_end
  log ""
  wizard_echo_command "scaffold publish --${visibility}"
  log ""
  _wizard_confirm "Publish ${1} to GitHub?" || return 0
  [ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" = 1 ] && return 0
  cmd_publish "$1" "--${visibility}"
}

# ask_shape_questions <shape> <listing> — one screen per kind the shape asks
# about, leaving `kind=value` in WIZARD_ANSWERS.
#
# `for` over an array, because a `while read <<< ...` shares fd0 with
# tui_select's terminal reads: a keystroke meant for the screen would eat a byte
# of the remaining question list.
WIZARD_ANSWERS=()

ask_shape_questions() {
  local shape="$1" listing="$2" kind
  local -a kinds options

  WIZARD_ANSWERS=()
  mapfile -t kinds <<< "$(wizard_questions "$shape")"
  for kind in "${kinds[@]}"; do
    mapfile -t options < <(wizard_order_options "$kind" "$listing")
    _wizard_select_or_cancel "$(wizard_prompt_for "$kind")" "${options[@]}"
    WIZARD_ANSWERS+=("${kind}=${TUI_CHOICE}")
  done
}

# cmd_wizard — name, shape, then one to four more screens from
# wizard_questions(shape), ending on a summary and a confirm.
# SCAFFOLD_WIZARD_DRY_RUN=1 stops just before cmd_new, which lets
# tests/wizard.bats drive the real screens through a pty.
cmd_wizard() {
  tui_begin

  # Read by tui_select to pad every question to one answer column. Before the
  # first screen, which is now the action menu, not the name prompt.
  # shellcheck disable=SC2034 # read by lib/tui.sh, not by this file
  TUI_ANSWER_COLUMN="$(wizard_prompt_width)"

  # update and publish act on a project that already exists, so they are offered
  # only from inside one.
  local here=""
  here="$(git rev-parse --show-toplevel 2>/dev/null)" || here=""
  [ -n "$here" ] && is_scaffold_project "$here" || here=""

  local action=new
  local -a action_options
  mapfile -t action_options < <(wizard_actions "$([ -n "$here" ] && printf 1 || printf 0)")
  # A menu with one answer asks nothing and costs a keystroke.
  if [ "${#action_options[@]}" -gt 1 ]; then
    _wizard_select_or_cancel "$WIZARD_ACTION_PROMPT" "${action_options[@]}"
    action="$TUI_CHOICE"
  fi

  case "$action" in
    update) _wizard_update "$here"; return ;;
    publish) _wizard_publish "$here"; return ;;
  esac

  local name; name="$(tui_prompt_name)"
  local listing; listing="$(cmd_list)"

  local -a shape_options
  mapfile -t shape_options < <(wizard_shapes)
  _wizard_select_or_cancel "$WIZARD_SHAPE_PROMPT" "${shape_options[@]}"
  local shape="$TUI_CHOICE"

  ask_shape_questions "$shape" "$listing"

  tui_end

  # Each question already collapsed into its own "✔ question  answer" line, so
  # only the command line is new information.
  log ""
  wizard_echo_command "$(wizard_command "$name" "${WIZARD_ANSWERS[@]}")"
  log ""

  _wizard_confirm "Generate this project?" || return 0
  [ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" = 1 ] && return 0

  local -a new_args
  mapfile -t new_args < <(wizard_new_args "${WIZARD_ANSWERS[@]}")
  cmd_new "$name" "${new_args[@]}"
}

# ─── entry point ───────────────────────────────────────────────────────────

main() {
  # Before the toolchain is checked: this question is usually asked because
  # something is wrong with the install, so it must not itself fail with
  # "missing required tool(s): yq".
  case "${1:-}" in
    -v|--version) scaffold_version; printf '\n'; return ;;
  esac

  load_toolchain_env
  require_tools

  # A terminal, and only a terminal: a bare call that opened a menu in a script,
  # in CI or in this repository's tests would hang as a timeout, not fail.
  if [ $# -eq 0 ]; then
    [ -t 0 ] || { usage >&2; exit 1; }
    cmd_wizard
    return
  fi

  local command="$1"; shift
  case "$command" in
    new) cmd_new "$@" ;;
    add) cmd_add "$@" ;;
    update) cmd_update "$@" ;;
    publish) cmd_publish "$@" ;;
    list) cmd_list "$@" ;;
    lint) cmd_lint "$@" ;;
    -h|--help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
