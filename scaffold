#!/usr/bin/env bash
# Create and extend projects that follow the task contract. With no arguments
# on a terminal, runs the interactive wizard. The full synopsis is usage().
#
# Usage:   scaffold [new|add|update|publish|list|lint] [args]
# Example: scaffold new demo --web nextjs --api nestjs --db postgres
set -euo pipefail

SCAFFOLD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCAFFOLD_ROOT

# shellcheck source=lib/log.sh
source "${SCAFFOLD_ROOT}/lib/log.sh"
# shellcheck source=lib/contract.sh
source "${SCAFFOLD_ROOT}/lib/contract.sh"
# shellcheck source=lib/lint.sh
source "${SCAFFOLD_ROOT}/lib/lint.sh"
# shellcheck source=lib/adapter.sh
source "${SCAFFOLD_ROOT}/lib/adapter.sh"
# shellcheck source=lib/service.sh
source "${SCAFFOLD_ROOT}/lib/service.sh"
# shellcheck source=lib/wizard.sh
source "${SCAFFOLD_ROOT}/lib/wizard.sh"
# shellcheck source=lib/tui.sh
source "${SCAFFOLD_ROOT}/lib/tui.sh"
# shellcheck source=lib/project.sh
source "${SCAFFOLD_ROOT}/lib/project.sh"
# shellcheck source=lib/pnpm.sh
source "${SCAFFOLD_ROOT}/lib/pnpm.sh"
# shellcheck source=lib/manifest.sh
source "${SCAFFOLD_ROOT}/lib/manifest.sh"
# shellcheck source=lib/update.sh
source "${SCAFFOLD_ROOT}/lib/update.sh"
# shellcheck source=lib/publish.sh
source "${SCAFFOLD_ROOT}/lib/publish.sh"

REQUIRED_TOOLS=(git mise jq yq)

SCAFFOLD_SERVICES=()

usage() {
  cat <<'EOF'
usage:
  scaffold                    interactive wizard (needs a terminal)
  scaffold new <name> [--web <adapter>] [--api <adapter>] [--app <adapter>]
                      [--db <service>] [--cache <service>]
  scaffold add <dir> --adapter <adapter>
  scaffold update [dir] [--dry-run]
  scaffold publish [dir] [--public] [--no-protect] [--dry-run]
  scaffold list [--adapters] [--services]
  scaffold lint
  scaffold --version
EOF
}

# jq and yq are pinned in this toolbox's mise.toml. `mise env -C`, not
# `mise exec -C`, which also changes directory and would resolve a relative
# target inside the toolbox. Silent: require_tools names a real absence.
load_toolchain_env() {
  command -v jq >/dev/null 2>&1 && command -v yq >/dev/null 2>&1 && return 0
  command -v mise >/dev/null 2>&1 || return 0

  local environment
  environment="$(mise env -C "$SCAFFOLD_ROOT" -s bash 2>/dev/null)" || return 0
  eval "$environment"
}

require_tools() {
  local tool missing=()

  for tool in "${REQUIRED_TOOLS[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done

  ((${#missing[@]} == 0)) && return 0
  die "missing required tool(s): ${missing[*]} — run 'mise install' in ${SCAFFOLD_ROOT}"
}

# `mise exec` walks upward, trusts the config it finds and runs its `_.source`
# and `exec()`: generating inside someone else's tree would run their
# mise.toml. Exported once, so every mise this run spawns is covered.
confine_mise_to() {
  local -r target="$1"

  MISE_CEILING_PATHS="$(dirname "$target")"
  export MISE_CEILING_PATHS
}

resolve_project() {
  local rel="$1" command="$2" project

  if [[ -n "$rel" ]]; then
    project="$(cd "$rel" 2>/dev/null && pwd)" || die "no such directory: ${rel}"
  else
    project="$(git rev-parse --show-toplevel 2>/dev/null)" ||
      die "not inside a git repository: run 'scaffold ${command}' from inside a project created by 'scaffold new', or give its path"
  fi

  is_scaffold_project "$project" || die "not a scaffold project (${project})"
  printf '%s' "$project"
}

# The collectors return 1 on anything malformed, after adding every good row.
LIST_ROWS=()

collect_adapter_rows() {
  local adapter name status=0

  for adapter in "${SCAFFOLD_ROOT}"/adapters/*/; do
    [[ -d "$adapter" ]] || continue
    name="$(basename "$adapter")"

    if load_adapter "$name" 2>/dev/null; then
      # shellcheck disable=SC2153 # ADAPTER_NAME, ADAPTER_ROLE, ADAPTER_TIER are sourced from adapter.env
      LIST_ROWS+=("$ADAPTER_NAME"$'\t'"$ADAPTER_ROLE"$'\t'"$ADAPTER_TIER")
    else
      LIST_ROWS+=("[error]"$'\t'"$name"$'\t'"(malformed adapter)")
      status=1
    fi

    unset -v ADAPTER_DIR ADAPTER_NAME ADAPTER_GENERATOR "${ADAPTER_OPTIONAL_VARS[@]}"
  done

  return "$status"
}

collect_service_rows() {
  local service name status=0

  for service in "${SCAFFOLD_ROOT}"/services/*/; do
    [[ -d "$service" ]] || continue
    name="$(basename "$service")"
    [[ "$name" == "$SHARED_DRIVERS_DIR" ]] && continue

    if load_service "$name" >/dev/null 2>&1; then
      LIST_ROWS+=("$SERVICE_NAME"$'\t'"$SERVICE_KIND"$'\t'"-")
    else
      LIST_ROWS+=("[error]"$'\t'"$name"$'\t'"(malformed service)")
      status=1
    fi

    unset -v SERVICE_DIR SERVICE_NAME SERVICE_KIND SERVICE_IMAGE
  done

  return "$status"
}

cmd_list() {
  local status=0
  local want_adapters=0 want_services=0

  while (($# > 0)); do
    case "$1" in
      --adapters)
        want_adapters=1
        shift
        ;;
      --services)
        want_services=1
        shift
        ;;
      *) die "unknown option: ${1}" ;;
    esac
  done

  if ((want_adapters == 0)) && ((want_services == 0)); then
    want_adapters=1
    want_services=1
  fi

  LIST_ROWS=()
  ((want_adapters == 1)) && { collect_adapter_rows || status=1; }
  ((want_services == 1)) && { collect_service_rows || status=1; }

  printf '%s\n' ${LIST_ROWS[@]+"${LIST_ROWS[@]}"} | sort
  return "$status"
}

cmd_lint() {
  local status=0
  lint_adapters "${SCAFFOLD_ROOT}/adapters" || status=1
  lint_services "${SCAFFOLD_ROOT}/services" "${SCAFFOLD_ROOT}/adapters" || status=1
  return "$status"
}

# An EXIT trap, not ERR: die() exits directly and never trips ERR. A
# generator's orphaned child can still write into $target after the rm -rf.
cmd_new_cleanup() {
  local -r target="$1" status="$2"

  ((status == 0)) && return 0
  [[ -n "$target" ]] || return 0

  rm -rf "$target"
  warn "removed incomplete project: ${target}"
}

NEW_APPS=()
NEW_DATABASE=""
NEW_CACHE=""

parse_new_flags() {
  NEW_APPS=()
  NEW_DATABASE=""
  NEW_CACHE=""

  while (($# > 0)); do
    case "$1" in
      --web | --api | --app)
        (($# >= 2)) || die "${1} requires an adapter name"
        # A second generator would silently run over the first app's directory.
        case " ${NEW_APPS[*]-} " in
          *" ${1#--}:"*) die "${1} given more than once" ;;
        esac
        NEW_APPS+=("${1#--}:${2}")
        shift 2
        ;;
      --db)
        (($# >= 2)) || die "--db requires a service name"
        [[ -z "$NEW_DATABASE" ]] || die "--db given more than once"
        NEW_DATABASE="$2"
        shift 2
        ;;
      --cache)
        (($# >= 2)) || die "--cache requires a service name"
        [[ -z "$NEW_CACHE" ]] || die "--cache given more than once"
        NEW_CACHE="$2"
        shift 2
        ;;
      *) die "unknown option: ${1}" ;;
    esac
  done
}

project_has_backend() {
  local entry
  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    case "$entry" in api:* | app:*) return 0 ;; esac
  done
  return 1
}

# The web tier takes no driver, so without a backend a service would run with
# nothing able to reach it.
assert_service_connectable() {
  local -r flag="$1" kind="$2" service="$3"

  [[ "$service" != "none" ]] || return 0
  project_has_backend ||
    die "${flag} ${service} but there is no application to connect it — add --api or --app"
  load_service "$service"
  [[ "$SERVICE_KIND" == "$kind" ]] ||
    die "${service} is a ${SERVICE_KIND}, not a ${kind}"
}

resolve_service_selection() {
  if [[ -z "$NEW_DATABASE" ]]; then
    project_has_backend && NEW_DATABASE="$DEFAULT_DATABASE_SERVICE" || NEW_DATABASE=none
  fi
  [[ -n "$NEW_CACHE" ]] || NEW_CACHE=none

  assert_service_connectable --db database "$NEW_DATABASE"
  assert_service_connectable --cache cache "$NEW_CACHE"

  SCAFFOLD_SERVICES=()
  local service
  for service in "$NEW_DATABASE" "$NEW_CACHE"; do
    [[ "$service" != "none" ]] && SCAFFOLD_SERVICES+=("$service")
  done
  return 0
}

install_adapters() {
  local -r target="$1"
  local entry role adapter rel

  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    role="${entry%%:*}"
    adapter="${entry#*:}"
    load_adapter "$adapter"
    [[ "$ADAPTER_ROLE" == "$role" ]] ||
      die "adapter ${adapter} has role ${ADAPTER_ROLE}, not ${role}"
    rel="$(role_path "$ADAPTER_ROLE")"
    # Before the adapter: a driver's compose environment merges into this service.
    add_app_service "$target" "$rel" "$ADAPTER_ROLE"
    apply_adapter "$adapter" "$target" "$rel"
    record_scaffold_app "$target" "$rel" "$adapter"
  done
}

# A shared packages/types needs every application to be TypeScript. The root
# workspace file stays either way: its allowBuilds (ADR-0017) covers any node
# install. Image targets come last, since the build context depends on the
# shape (ADR-0022).
settle_workspace_shape() {
  local -r target="$1"
  local entry all_typescript=1
  local -a apps=()

  for entry in ${NEW_APPS[@]+"${NEW_APPS[@]}"}; do
    adapter_is_typescript "${entry#*:}" || all_typescript=0
    apps+=("$(role_path "${entry%%:*}"):${entry#*:}")
  done

  if ((${#apps[@]} > 0)) && ((all_typescript == 1)); then
    join_typescript_workspace "$target" "${apps[@]}"
  else
    keep_apps_standalone "$target" ${apps[@]+"${apps[@]}"}
  fi

  local pair
  for pair in ${apps[@]+"${apps[@]}"}; do
    register_image_target "$target" "${pair%%:*}"
  done
}

print_next_steps() {
  local -r project="$1"

  log ""
  log "created ${project}"
  log ""
  log "next:"
  log "  cd ${project}"
  log "  mise install && mise exec -- lefthook install"
  log "  scaffold publish              # create its GitHub repository"
  log "  mise run checklist            # what CI will run"
}

cmd_new() {
  (($# > 0)) || die "new requires a project name"

  local target="$1"
  shift
  # Absolute: a driver receives it as SCAFFOLD_PROJECT_ROOT from the app's cwd.
  case "$target" in
    /*) ;;
    *) target="$(pwd)/${target}" ;;
  esac

  confine_mise_to "$target"
  parse_new_flags "$@"
  resolve_service_selection

  # Arms the cleanup trap right after it creates $target.
  init_project "$target" "$(basename "$target")"
  init_scaffold_manifest "$target"

  record_services "$target" "$NEW_DATABASE" "$NEW_CACHE"
  assemble_compose "$target" ${SCAFFOLD_SERVICES[@]+"${SCAFFOLD_SERVICES[@]}"}
  assemble_example_env "$target" ${SCAFFOLD_SERVICES[@]+"${SCAFFOLD_SERVICES[@]}"}

  install_adapters "$target"
  settle_workspace_shape "$target"

  step "locking the toolchain and committing"
  finalize_project "$target"
  trap - EXIT

  print_next_steps "$target"
}

# The workspace relaxations must not survive a failure either. A failure after
# apply_adapter still leaves edits to files the caller owned (config_roots,
# lefthook, lockfile, roots:) naming the removed app; those have no general undo.
cmd_add_cleanup() {
  local -r target="$1" status="$2" workspace_file="$3"

  restore_pnpm_workspace "$workspace_file"

  ((status == 0)) && return 0
  [[ -n "$target" ]] || return 0

  rm -rf "$target"
  warn "removed incomplete app: ${target}"
}

# The git root, not the cwd, so `scaffold add` works from deep inside an app.
add_project_root() {
  local project
  project="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    die "not inside a git repository: run 'scaffold add' from inside a project created by 'scaffold new'"
  is_scaffold_project "$project" ||
    die "not a scaffold project (${project}): run 'scaffold add' from inside a project created by 'scaffold new'"
  printf '%s' "$project"
}

# Read back, not asked: an app added in month six wires to the database the
# project has had since month one.
load_recorded_services() {
  local -r project="$1"
  local kind recorded

  SCAFFOLD_SERVICES=()
  for kind in database cache; do
    recorded="$(project_service "$project" "$kind")"
    [[ -n "$recorded" ]] && SCAFFOLD_SERVICES+=("$recorded")
  done
  return 0
}

# Keyed on `packages:`, not on the file existing: a mixed-language project keeps
# a settings-only file, and reconciling it would delete every per-app lockfile.
joins_shared_workspace() {
  local -r project="$1" adapter="$2"
  local -r workspace_file="${project}/${WORKSPACE_FILE}"

  [[ -f "$workspace_file" ]] &&
    [[ "$(yq -r '.packages // "absent"' "$workspace_file")" != "absent" ]] &&
    adapter_is_typescript "$adapter"
}

reconcile_shared_workspace() {
  local -r project="$1"

  sync_workspace_lockfile "$project"
  record_release_age_exceptions "$project"
}

# Adding the first TypeScript app to a project with no workspace file brings
# ADR-0017's build policy into scope with nowhere to hold it, and pnpm refuses
# the install (ERR_PNPM_IGNORED_BUILDS). Restored without `packages:`.
reconcile_standalone_app() {
  local -r project="$1" rel="$2" adapter="$3"
  local -r workspace_file="${project}/${WORKSPACE_FILE}"

  if adapter_is_typescript "$adapter" && [[ ! -f "$workspace_file" ]]; then
    yq '{"allowBuilds": .allowBuilds}' \
      "${SCAFFOLD_ROOT}/common/${WORKSPACE_FILE}" >"$workspace_file"
  fi

  record_release_age_exceptions "${project}/${rel}" "$project"
}

# Only the new app is staged, so `git diff` shows the edits to files the caller
# already owned. A failed `git add` is retriable by hand.
stage_new_app() {
  local -r project="$1" rel="$2" adapter="$3"

  if git -C "$project" add -A -- "$rel"; then
    log "added ${rel} using ${adapter}; review and commit"
  else
    warn "added ${rel} using ${adapter}, but staging failed: the app was generated and the configuration was updated, run 'git add' yourself to stage it"
  fi
}

ADD_ADAPTER=""

parse_add_flags() {
  ADD_ADAPTER=""

  while (($# > 0)); do
    case "$1" in
      --adapter)
        (($# >= 2)) || die "--adapter requires an adapter name"
        ADD_ADAPTER="$2"
        shift 2
        ;;
      *) die "unknown option: ${1}" ;;
    esac
  done

  [[ -n "$ADD_ADAPTER" ]] || die "--adapter is required"
}

cmd_add() {
  (($# >= 3)) || die "usage: scaffold add <dir> --adapter <adapter>"

  local -r rel="$1"
  shift
  parse_add_flags "$@"
  local -r adapter="$ADD_ADAPTER"

  local project
  project="$(add_project_root)"
  confine_mise_to "$project"
  load_recorded_services "$project"

  local -r dest="${project}/${rel}"
  [[ -e "$dest" ]] && die "path already exists: ${rel}"

  # add_app_service needs the role before apply_adapter loads it.
  load_adapter "$adapter"

  local reconcile=0
  joins_shared_workspace "$project" "$adapter" && reconcile=1

  # Armed only once $dest is proven absent, or this would rm -rf the caller's path.
  local -r workspace_file="${project}/${WORKSPACE_FILE}"
  # shellcheck disable=SC2064 # $dest/$workspace_file expanding now is intentional; $? is escaped and still deferred
  trap "cmd_add_cleanup $(printf '%q' "$dest") \"\$?\" $(printf '%q' "$workspace_file")" EXIT

  relax_pnpm_workspace "$workspace_file"
  add_app_service "$project" "$rel" "$ADAPTER_ROLE"
  apply_adapter "$adapter" "$project" "$rel"
  settle_added_app "$project" "$rel" "$adapter" "$reconcile"
  trap - EXIT

  stage_new_app "$project" "$rel" "$adapter"
}

settle_added_app() {
  local -r project="$1" rel="$2" adapter="$3" reconcile="$4"

  # Reads the workspace globs as they stand, without recomputing whether the
  # project is all-TypeScript (ADR-0018).
  finalize_app_dockerfile "$project" "$rel"
  # Here too, not left to the trap: the caller disarms it on success.
  restore_pnpm_workspace "${project}/${WORKSPACE_FILE}"

  if ((reconcile == 1)); then
    reconcile_shared_workspace "$project"
  else
    reconcile_standalone_app "$project" "$rel" "$adapter"
  fi

  sync_ci_roots "$project"
  # After finalize_app_dockerfile, which settles which variant is ${rel}/Dockerfile.
  register_image_target "$project" "$rel"
  record_scaffold_app "$project" "$rel" "$adapter"
}

update_source_commit() {
  local -r project="$1"
  local from

  from="$(manifest_version "$project")" || die "$(printf '%s\n' \
    "no ${SCAFFOLD_MANIFEST} in ${project}, so there is nothing to update from." \
    "" \
    "A project generated before this file existed can adopt it: write" \
    "${SCAFFOLD_MANIFEST} with the toolbox commit it came from and the adapter" \
    "behind each application, then run this again." \
    "" \
    "  version = \"<commit>\"" \
    "" \
    "  [apps]" \
    "  \"apps/api\" = \"nestjs\"")"

  case "$from" in
    *-dirty)
      die "${SCAFFOLD_MANIFEST} records ${from}: this project was generated from uncommitted edits, so there is no commit to diff against"
      ;;
  esac
  git -C "$SCAFFOLD_ROOT" rev-parse --verify --quiet "${from}^{commit}" >/dev/null ||
    die "this toolbox has no commit ${from} — the checkout that generated ${project} is not this one, or its history was rewritten"

  printf '%s' "$from"
}

# Recorded even when hunks were rejected: re-running from the old version would
# offer every hunk that already landed a second time.
record_update_version() {
  local -r project="$1"

  sed -i.bak "s|^version = .*|version = \"$(scaffold_version)\"|" \
    "${project}/${SCAFFOLD_MANIFEST}"
  rm -f "${project}/${SCAFFOLD_MANIFEST}.bak"
}

report_rejected_hunks() {
  local -r project="$1"
  local -a rejected=()

  mapfile -t rejected < <(cd "$project" && git ls-files --others --exclude-standard -- '*.rej')
  ((${#rejected[@]} > 0)) || return 0

  warn "$(printf '%s\n' "${#rejected[@]} file(s) could not be applied in full:" "${rejected[@]/#/  }" \
    "each .rej holds the hunks that did not fit — place them by hand, then delete it")"
}

UPDATE_REL=""
UPDATE_DRY_RUN=0

parse_update_flags() {
  UPDATE_REL=""
  UPDATE_DRY_RUN=0

  while (($# > 0)); do
    case "$1" in
      --dry-run)
        UPDATE_DRY_RUN=1
        shift
        ;;
      -*) die "unknown option: ${1}" ;;
      *)
        [[ -z "$UPDATE_REL" ]] || die "update takes at most one directory"
        UPDATE_REL="$1"
        shift
        ;;
    esac
  done
}

cmd_update() {
  parse_update_flags "$@"

  local project from patch
  project="$(resolve_project "$UPDATE_REL" update)"
  from="$(update_source_commit "$project")"
  SCAFFOLD_UPDATE_FROM="$from"

  patch="$(mktemp)"
  update_patch "$project" >"$patch"

  if [[ ! -s "$patch" ]]; then
    rm -f "$patch"
    log "already up to date with $(scaffold_version)"
    return 0
  fi

  if ((UPDATE_DRY_RUN == 1)); then
    cat "$patch"
    rm -f "$patch"
    return 0
  fi

  apply_update_patch "$project" "$patch" "$from"
}

apply_update_patch() {
  local -r project="$1" patch="$2" from="$3"

  # `git diff` afterwards is the only review, so it must show this run alone.
  [[ -z "$(git -C "$project" status --porcelain)" ]] ||
    {
      rm -f "$patch"
      die "${project} has uncommitted changes — commit or stash them first, so 'git diff' afterwards shows only what this brought in"
    }

  local status=0
  git -C "$project" apply --reject --whitespace=nowarn "$patch" || status=$?
  rm -f "$patch"

  resync_derived_files "$project"
  record_update_version "$project"

  log "updated ${project} from ${from} to $(scaffold_version)"
  report_rejected_hunks "$project"
  log "review with 'git -C ${project} diff' before committing"
  return "$status"
}

# A setting the account's plan does not allow warns rather than fails: refusing
# would lock out the accounts that most need the steps before it.
apply_repo_settings() {
  local -r slug="$1" protect="$2"
  local status=0

  allow_actions_to_open_pull_requests "$slug"
  log "Actions may open pull requests (Release Please needs this)"

  enable_secret_scanning "$slug" || status=$?
  case "$status" in
    0) log "secret scanning and push protection are on" ;;
    "$PUBLISH_UNSUPPORTED") warn "no secret scanning: it needs Advanced Security on a private repository. The CI scan still runs on every push" ;;
    *) die "could not enable secret scanning on ${slug}" ;;
  esac

  ((protect == 1)) && protect_main_branch "$slug"

  if set_release_secrets "$slug"; then
    log "set RELEASE_APP_ID and RELEASE_APP_PRIVATE_KEY"
  else
    warn "no RELEASE_APP_ID/RELEASE_APP_PRIVATE_KEY in the environment — Release Please will open its pull request as GITHUB_TOKEN, whose checks sit at 'Action required' and then expire red. Merging it still releases."
  fi
  return 0
}

protect_main_branch() {
  local -r slug="$1"
  local status=0

  if main_is_protected "$slug"; then
    log "main already has a ruleset — left alone"
    return 0
  fi

  protect_main "$slug" || status=$?
  case "$status" in
    0) log "protected main: pull request required, no force-push, no deletion" ;;
    "$PUBLISH_UNSUPPORTED") warn "main is unprotected: this account's plan does not allow rulesets on a private repository. Make it public, or upgrade, then run this again — ADR-0004 counts branch protection as one of four guardrails, and it is the only one that is not a file" ;;
    *) die "could not protect main on ${slug}" ;;
  esac
}

PUBLISH_REL=""
PUBLISH_VISIBILITY=private
PUBLISH_PROTECT=1
PUBLISH_DRY_RUN=0

parse_publish_flags() {
  PUBLISH_REL=""
  PUBLISH_VISIBILITY=private
  PUBLISH_PROTECT=1
  PUBLISH_DRY_RUN=0

  while (($# > 0)); do
    case "$1" in
      --public)
        PUBLISH_VISIBILITY=public
        shift
        ;;
      --private)
        PUBLISH_VISIBILITY=private
        shift
        ;;
      --no-protect)
        PUBLISH_PROTECT=0
        shift
        ;;
      --dry-run)
        PUBLISH_DRY_RUN=1
        shift
        ;;
      -*) die "unknown option: ${1}" ;;
      *)
        [[ -z "$PUBLISH_REL" ]] || die "publish takes at most one directory"
        PUBLISH_REL="$1"
        shift
        ;;
    esac
  done
}

require_github_cli() {
  command -v gh >/dev/null 2>&1 ||
    die "publish needs the GitHub CLI: install gh and run 'gh auth login'"
  gh auth status >/dev/null 2>&1 ||
    die "not signed in to GitHub: run 'gh auth login'"
}

# Idempotent: against an existing repository it only applies the settings, the
# half nothing in the project's files records.
cmd_publish() {
  parse_publish_flags "$@"
  require_github_cli

  local project slug exists=0
  project="$(resolve_project "$PUBLISH_REL" publish)"
  slug="$(repo_slug "$project")"
  gh_repo_exists "$slug" && exists=1

  ((exists == 1)) || assert_repo_creatable "$project" "$slug"

  if ((PUBLISH_DRY_RUN == 1)); then
    print_publish_plan "$slug" "$PUBLISH_VISIBILITY" "$exists" "$PUBLISH_PROTECT"
    return 0
  fi

  if ((exists == 1)); then
    log "${slug} already exists — applying settings only"
  else
    create_repo "$project" "$slug" "$PUBLISH_VISIBILITY"
    log "created ${slug} (${PUBLISH_VISIBILITY}) and pushed main"
  fi

  apply_repo_settings "$slug" "$PUBLISH_PROTECT"

  log "https://github.com/${slug}"
}

# `gh repo create --push` makes the checked-out branch the default, so from a
# feature branch the project would have no main.
assert_repo_creatable() {
  local -r project="$1" slug="$2"

  local branch
  branch="$(git -C "$project" rev-parse --abbrev-ref HEAD)"
  [[ "$branch" == "main" ]] ||
    die "publish creates ${slug} from the branch you are on, and that branch becomes its default — check out main first (you are on ${branch})"
  [[ -z "$(git -C "$project" status --porcelain)" ]] ||
    die "${project} has uncommitted changes — commit them first, so what reaches ${slug} is what you reviewed"

  # An origin while ${slug} does not exist means the project already pushes
  # somewhere else; `gh repo create --remote origin` would fail on it with an
  # unexplained "Unable to add remote".
  local origin=""
  if origin="$(git -C "$project" remote get-url origin 2>/dev/null)"; then
    die "$(printf '%s\n' \
      "${project} already pushes to ${origin}, but it names ${slug}." \
      "Publishing would create a second repository beside the one it is already using." \
      "Point the project at the repository it has ([vars] image in mise.toml, and" \
      "the same pair in compose.yaml, install.sh and the build workflows), or drop" \
      "the remote with 'git -C ${project} remote remove origin'.")"
  fi
}

print_publish_plan() {
  local -r slug="$1" visibility="$2" exists="$3" protect="$4"

  if ((exists == 1)); then
    log "would leave ${slug} alone: it already exists"
  else
    log "would create ${slug} (${visibility}) and push main"
  fi

  log "would allow Actions to open pull requests on ${slug}"
  log "would enable secret scanning and push protection"

  if ((protect == 1)); then
    if main_is_protected "$slug"; then
      log "would leave main's protection alone: a ruleset named main already exists"
    else
      log "would protect main on ${slug}: pull request required, no force-push, no deletion"
    fi
  fi

  if [[ -n "${RELEASE_APP_ID:-}" ]] && [[ -n "${RELEASE_APP_PRIVATE_KEY:-}" ]]; then
    log "would set RELEASE_APP_ID and RELEASE_APP_PRIVATE_KEY"
  else
    log "would skip the release app secrets: they are not in the environment"
  fi
}

# Esc exits as tui_begin's Ctrl-C does. No back navigation, by design.
_wizard_select_or_cancel() {
  tui_select "$@" || exit 130
}

# `y`, not Enter: every action past this changes something that exists.
_wizard_confirm() {
  local -r question="$1"

  printf '%b' "${BOLD}${question} [y/N] ${RESET}" >&2
  local reply=""
  IFS= read -r reply || true
  case "$reply" in y | Y) return 0 ;; *) return 1 ;; esac
}

_wizard_update() {
  local -r project="$1"

  tui_end
  log ""
  wizard_echo_command "scaffold update"
  log ""
  _wizard_confirm "Bring ${project} up to this toolbox?" || return 0
  [[ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" == "1" ]] && return 0
  cmd_update "$project"
}

_wizard_publish() {
  local -r project="$1"
  local -a options
  mapfile -t options < <(wizard_visibilities)
  _wizard_select_or_cancel "$WIZARD_VISIBILITY_PROMPT" "${options[@]}"
  local visibility="$TUI_CHOICE"

  tui_end
  log ""
  wizard_echo_command "scaffold publish --${visibility}"
  log ""
  _wizard_confirm "Publish ${project} to GitHub?" || return 0
  [[ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" == "1" ]] && return 0
  cmd_publish "$project" "--${visibility}"
}

WIZARD_ANSWERS=()

# Leaves `kind=value` pairs in WIZARD_ANSWERS. `for` over an array, not
# `while read <<<`: that shares fd0 with tui_select, and a keystroke would eat a
# byte of the question list.
ask_shape_questions() {
  local -r shape="$1" listing="$2"
  local kind
  local -a kinds options

  WIZARD_ANSWERS=()
  mapfile -t kinds <<<"$(wizard_questions "$shape")"
  for kind in "${kinds[@]}"; do
    mapfile -t options < <(wizard_order_options "$kind" "$listing")
    _wizard_select_or_cancel "$(wizard_prompt_for "$kind")" "${options[@]}"
    WIZARD_ANSWERS+=("${kind}=${TUI_CHOICE}")
  done
}

# SCAFFOLD_WIZARD_DRY_RUN=1 stops before anything is changed, so
# tests/wizard.bats can drive the real screens through a pty.
cmd_wizard() {
  tui_begin

  # shellcheck disable=SC2034 # read by lib/tui.sh, not by this file
  TUI_ANSWER_COLUMN="$(wizard_prompt_width)"

  local here
  here="$(_wizard_project_here)"

  local action=new
  local -a action_options
  mapfile -t action_options < <(wizard_actions "$([[ -n "$here" ]] && printf 1 || printf 0)")
  # A menu with one answer asks nothing and costs a keystroke.
  if ((${#action_options[@]} > 1)); then
    _wizard_select_or_cancel "$WIZARD_ACTION_PROMPT" "${action_options[@]}"
    action="$TUI_CHOICE"
  fi

  case "$action" in
    update) _wizard_update "$here" ;;
    publish) _wizard_publish "$here" ;;
    *) _wizard_new ;;
  esac
}

# Empty outside a scaffold project, where update and publish are not offered.
_wizard_project_here() {
  local here=""
  here="$(git rev-parse --show-toplevel 2>/dev/null)" || here=""
  [[ -n "$here" ]] && is_scaffold_project "$here" || here=""
  printf '%s' "$here"
}

_wizard_new() {
  local name listing shape
  local -a shape_options new_args

  name="$(tui_prompt_name)"
  listing="$(cmd_list)"

  mapfile -t shape_options < <(wizard_shapes)
  _wizard_select_or_cancel "$WIZARD_SHAPE_PROMPT" "${shape_options[@]}"
  shape="$TUI_CHOICE"

  ask_shape_questions "$shape" "$listing"

  tui_end

  # Each answer already collapsed into its own line; only the command is new.
  log ""
  wizard_echo_command "$(wizard_command "$name" "${WIZARD_ANSWERS[@]}")"
  log ""

  _wizard_confirm "Generate this project?" || return 0
  [[ "${SCAFFOLD_WIZARD_DRY_RUN:-0}" == "1" ]] && return 0

  mapfile -t new_args < <(wizard_new_args "${WIZARD_ANSWERS[@]}")
  cmd_new "$name" "${new_args[@]}"
}

main() {
  # Before the toolchain check: this is usually asked because the install is
  # broken, so it must not fail on a missing yq.
  case "${1:-}" in
    -v | --version)
      scaffold_version
      printf '\n'
      return
      ;;
  esac

  load_toolchain_env
  require_tools

  # A terminal only: a menu opened in a script or CI hangs rather than fails.
  if (($# == 0)); then
    [[ -t 0 ]] || {
      usage >&2
      exit 1
    }
    cmd_wizard
    return
  fi

  local command="$1"
  shift
  case "$command" in
    new) cmd_new "$@" ;;
    add) cmd_add "$@" ;;
    update) cmd_update "$@" ;;
    publish) cmd_publish "$@" ;;
    list) cmd_list "$@" ;;
    lint) cmd_lint "$@" ;;
    -h | --help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
