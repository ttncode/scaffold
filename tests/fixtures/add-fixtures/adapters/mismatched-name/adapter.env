ADAPTER_NAME="mismatched-name"
ADAPTER_ROLE="web"
ADAPTER_FAMILY="next"
ADAPTER_TIER="C"
ADAPTER_LANGUAGE="typescript"
# a generator that names its package.json something other than the role —
# exactly what verify_workspace_filter_name guards against.
ADAPTER_GENERATOR='mkdir -p "$APP_DIR" && printf "{\"name\": \"wrong-name\"}" > "$APP_DIR/package.json"'
